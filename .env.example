# Never commit real values. In production use `fly secrets set`.
OPENSERV_API_KEY=
SERV_BASE_URL=https://inference-api.openserv.ai/v1
SERV_MODEL=gpt-5.4-mini
SERV_JUDGE_MODEL=          # optional, defaults to SERV_MODEL
REPPO_API_KEY=             # optional; without it Reppo audits are off
SESSION_SECRET=            # required in production: openssl rand -hex 32
ADMIN_TOKEN=               # lets you grant plans: POST /api/admin/plan
COOKIE_SECURE=0            # 1 behind HTTPS
TRUST_PROXY=0              # 1 behind Fly/Cloudflare
SERV_AUDIT_MODEL=claude-haiku-4.5   # cross-model audit, used when Reppo is unavailable
REPPO_EVALS_PATH=/agents/evals   # Reppo moved its API; change here if it moves again
AUDIT_PROVIDER=auto        # auto | reppo | serv
REPPO_POLL_MS=20000
PORT=8787
DATA_DIR=./data
